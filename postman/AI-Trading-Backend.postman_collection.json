    {
      "name": "Upstox Auth",
      "description": "Semi-automated access-token approval and safe runtime status.",
      "item": [
        {
          "name": "Get Upstox Auth Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/upstox/auth/status",
            "description": "Returns readiness, source, expiry, and pending state without exposing credentials."
          }
        },
        {
          "name": "Request Upstox Access Token",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/upstox/auth/request-token",
            "description": "Calls the Upstox request API once; repeated calls reuse an unexpired pending request."
          }
        },
        {
          "name": "Receive Upstox Access Token Webhook",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_id\": \"{{upstoxClientId}}\",\n  \"user_id\": \"POSTMAN_USER\",\n  \"access_token\": \"POSTMAN_RUNTIME_TOKEN\",\n  \"token_type\": \"Bearer\",\n  \"expires_at\": \"{{upstoxExpiresAt}}\",\n  \"issued_at\": \"{{upstoxIssuedAt}}\",\n  \"message_type\": \"access_token\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/webhooks/upstox/access-token",
            "description": "Development replay of the documented notifier payload. Set upstoxClientId to UPSTOX_CLIENT_ID."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('upstoxIssuedAt', String(Date.now()));",
                  "pm.collectionVariables.set('upstoxExpiresAt', String(Date.now() + 60 * 60 * 1000));"
                ]
              }
            }
          ]
        }
      ]
    },
